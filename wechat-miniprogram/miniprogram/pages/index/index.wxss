.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.title {
  font-size: 52rpx;
  line-height: 1.15;
  font-weight: 700;
  color: #101828;
}

.subtitle {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #667085;
}

.connection-summary {
  max-width: 52%;
  text-align: right;
}

.computer-name {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 600;
  color: #344054;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.35;
  color: #667085;
}

.status-ready {
  color: #16803c;
}

.card {
  box-sizing: border-box;
  margin-bottom: 22rpx;
  padding: 28rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(16, 24, 40, 0.05);
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #101828;
}

.hint {
  margin-top: -8rpx;
  margin-bottom: 18rpx;
  font-size: 23rpx;
  color: #667085;
}

button {
  box-sizing: border-box;
  margin: 0;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
}

button[disabled] {
  opacity: 0.45;
}

.primary {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  color: #ffffff;
  background: #1769aa;
}

.secondary {
  width: 100%;
  height: 84rpx;
  margin-top: 16rpx;
  line-height: 84rpx;
  color: #344054;
  background: #f2f4f7;
}

.pairing-target {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f8fafc;
}

.pairing-name {
  overflow: hidden;
  font-size: 27rpx;
  font-weight: 600;
  color: #344054;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pairing-endpoint,
.saved-endpoint {
  margin-top: 4rpx;
  overflow: hidden;
  font-size: 22rpx;
  color: #667085;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.two-buttons,
.three-buttons {
  display: flex;
  gap: 14rpx;
  width: 100%;
}

.half {
  width: calc(50% - 7rpx);
}

.third {
  width: calc(33.333% - 10rpx);
}

.compact-row {
  margin-top: 14rpx;
}

.saved-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #f2f4f7;
}

.saved-row:first-of-type {
  border-top: 0;
}

.saved-info {
  min-width: 0;
  flex: 1;
}

.saved-name {
  overflow: hidden;
  font-size: 27rpx;
  font-weight: 500;
  color: #344054;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.small-button {
  width: 116rpx;
  height: 64rpx;
  padding: 0;
  line-height: 64rpx;
  font-size: 24rpx;
  color: #344054;
  background: #f2f4f7;
}

.danger {
  color: #b42318;
  background: #fff4f2;
}

.touchpad {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 560rpx;
  border: 2rpx solid #d0d5dd;
  border-radius: 26rpx;
  background: #f8fafc;
  user-select: none;
}

.touchpad-disabled {
  background: #f2f4f7;
}

.touchpad-label {
  font-size: 27rpx;
  color: #98a2b3;
}

.control-button {
  height: 82rpx;
  padding: 0 10rpx;
  line-height: 82rpx;
  color: #344054;
  background: #f2f4f7;
}

.draft {
  box-sizing: border-box;
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: #101828;
  background: #ffffff;
}

.warning {
  margin: 14rpx 0;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  font-size: 23rpx;
  line-height: 1.45;
  color: #b54708;
  background: #fffaeb;
}

.message {
  margin: 4rpx 4rpx 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #344054;
  background: #ffffff;
}

.footer {
  padding: 10rpx 24rpx 30rpx;
  text-align: center;
  font-size: 21rpx;
  line-height: 1.5;
  color: #98a2b3;
}
