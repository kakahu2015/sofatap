<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SofaTap</AssemblyName>
    <Version>0.8.0-beta.1</Version>
    <Product>HostTap Remote</Product>
    <AssemblyTitle>HostTap Remote</AssemblyTitle>
    <ApplicationIcon>Assets/SofaTap.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;preview/**</DefaultItemExcludes>
    <SofatapMsix Condition="'$(SofatapMsix)' == ''">false</SofatapMsix>
    <DefineConstants Condition="'$(SofatapMsix)' == 'true'">$(DefineConstants);SOFATAP_MSIX</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/SofaTap.ico" LogicalName="Sofatap.AppIcon" />
    <EmbeddedResource Include="Localization/Strings.zh.json" LogicalName="Sofatap.Localization.Strings.zh.json" WithCulture="false" />
  </ItemGroup>
</Project>
